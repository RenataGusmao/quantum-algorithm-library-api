generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  nome         String
  email        String   @unique
  senhaHash    String
  perfil       String   @default("admin")
  status       String   @default("ativo")
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  algoritmosCriados     Algoritmo[] @relation("CriadoPor")
  algoritmosAtualizados Algoritmo[] @relation("AtualizadoPor")

  @@map("users")
}

model TipoProblema {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nome      String   @unique
  descricao String?
  criadoEm  DateTime @default(now())

  algoritmos Algoritmo[]

  @@map("tipos_problema")
}

model Algoritmo {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  nome              String
  slug              String   @unique
  categoria         String?
  descricaoCurta    String
  descricaoCompleta String?

  complexidade      String?
  nivelDificuldade  String?
  maturidade        String?
  statusPublicacao  String   @default("rascunho")

  aplicacoes        String[]
  caracteristicas   String[]
  vantagens         String[]
  limitacoes        String[]
  tags              String[]

  linkOrigem        String?

  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  idTipoProblema String?       @db.ObjectId
  tipoProblema   TipoProblema? @relation(fields: [idTipoProblema], references: [id])

  criadoPorId String? @db.ObjectId
  criadoPor   User?   @relation("CriadoPor", fields: [criadoPorId], references: [id])

  atualizadoPorId String? @db.ObjectId
  atualizadoPor   User?   @relation("AtualizadoPor", fields: [atualizadoPorId], references: [id])

  referencias Referencia[]

  @@map("algoritmos")
}

model Referencia {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  titulo         String
  autores        String?
  ano            Int?
  tipoReferencia String?
  link           String?
  criadoEm       DateTime @default(now())

  algoritmoId String    @db.ObjectId
  algoritmo   Algoritmo @relation(fields: [algoritmoId], references: [id])

  @@map("referencias")
}